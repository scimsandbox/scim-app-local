# Playground PostgreSQL (service: postgres-server, host port 5432)
#
# Copy to postgres-server.env before starting the stack.
# These credentials are consumed by scim-server-db, scim-server-impl-spring,
# scim-server-impl-go and scim-server-ui-spring - change them in all of those
# files together or the services will not be able to connect.
#
# Postgres only applies these when it initialises an empty data directory, so
# changing them after the first start has no effect until you drop the volume:
#   docker compose -f docker-compose-spring.yml down --volumes

POSTGRES_DB=scimserver
POSTGRES_USER=scim_server_app
POSTGRES_PASSWORD=local-dev-server-pw-change-me
