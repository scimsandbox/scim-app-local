# Validator UI (service: scim-validator-ui-spring, http://localhost:8082)
#
# Copy to scim-validator-ui-spring.env before starting the stack.
# Used by both docker-compose-spring.yml and docker-compose-go.yml.
# Credentials must match env/postgres-validator.env.

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-validator:5432/scimvalidator
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=scim_validator_app
SPRING_DATASOURCE_PASSWORD=local-dev-validator-pw-change-me

# Guards the management endpoints on port 9090 (health, prometheus).
# Any non-empty value works locally; use a real secret outside development.
ACTUATOR_API_KEY=dev-actuator-key

# --- Auth0 / OIDC -----------------------------------------------------------
# REQUIRED. The UI has no local login fallback and will fail to start if these
# are unset. Register this as a SEPARATE Auth0 application from the management
# UI, because the two use different callback URLs.
#
# In the Auth0 application settings, add the redirect URI below to
# "Allowed Callback URLs" exactly as written.
#
# Never commit the filled-in file - env/*.env is gitignored for this reason.
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Trailing slash is required.
AUTH0_ISSUER_URI=https://your-tenant.eu.auth0.com/
AUTH0_REDIRECT_URI=http://localhost:8082/login/oauth2/code/auth0

# Must match the namespace used by the management UI and by your Auth0 Action.
APP_SECURITY_OIDC_ROLE_CLAIM=https://scimsandbox.local/roles
APP_SECURITY_OIDC_ADMIN_ROLE=admin
APP_SECURITY_OIDC_USER_ROLE=user

# --- Links rendered into the UI ---------------------------------------------
# Points back at the management UI. Resolved by the browser, so it uses
# localhost and the published host port - not a compose service name.
APP_PLAYGROUND_URL=http://localhost:8081
