# Cloudflare Tunnel sidecar (service: cloudflared)
#
# OPTIONAL. This service only runs under the "cloudflare" compose profile:
#
#   docker compose -f docker-compose-spring.yml --profile cloudflare up
#
# A plain local setup does not need it, and compose does not require this file
# unless the profile is enabled - so you can skip it entirely for local work.
#
# To actually publish the stack, create a tunnel in the Cloudflare Zero Trust
# dashboard and paste its connector token below. The token grants access to
# your Cloudflare account - treat it as a secret and never commit it.

TUNNEL_TOKEN=your-cloudflare-tunnel-token
