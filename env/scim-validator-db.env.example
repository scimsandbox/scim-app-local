# Flyway migrations for the validator database (service: scim-validator-db)
#
# Copy to scim-validator-db.env before starting the stack.
# The host name is the compose service name, not localhost, because Flyway runs
# inside the compose network. Credentials must match env/postgres-validator.env.

FLYWAY_URL=jdbc:postgresql://postgres-validator:5432/scimvalidator
FLYWAY_USER=scim_validator_app
FLYWAY_PASSWORD=local-dev-validator-pw-change-me
