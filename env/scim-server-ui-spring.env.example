# Management UI (service: scim-server-ui-spring, http://localhost:8081)
#
# Copy to scim-server-ui-spring.env before starting the stack.
# Used by both docker-compose-spring.yml and docker-compose-go.yml.
# Credentials must match env/postgres-server.env.

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-server:5432/scimserver
SPRING_DATASOURCE_USERNAME=scim_server_app
SPRING_DATASOURCE_PASSWORD=local-dev-server-pw-change-me

# Guards the management endpoints on port 9090 (health, prometheus).
# Any non-empty value works locally; use a real secret outside development.
ACTUATOR_API_KEY=dev-actuator-key

# --- Auth0 / OIDC -----------------------------------------------------------
# REQUIRED. The UI has no local login fallback and will fail to start if these
# are unset. Create a free Auth0 tenant and a "Regular Web Application", then
# copy its Client ID and Client Secret here.
#
# In the Auth0 application settings, add the redirect URI below to
# "Allowed Callback URLs" exactly as written.
#
# Never commit the filled-in file - env/*.env is gitignored for this reason.
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Trailing slash is required.
AUTH0_ISSUER_URI=https://your-tenant.eu.auth0.com/
AUTH0_REDIRECT_URI=http://localhost:8081/login/oauth2/code/auth0

# Roles are read from a custom claim on the ID token. Add an Auth0 Login Action
# that sets this namespaced claim to a list such as ["admin"], and keep the
# namespace here identical to the one the Action emits. Without a matching
# claim you will be signed in but have no permissions.
APP_SECURITY_OIDC_ROLE_CLAIM=https://scimsandbox.local/roles
APP_SECURITY_OIDC_ADMIN_ROLE=admin
APP_SECURITY_OIDC_USER_ROLE=user

# --- Links rendered into the UI ---------------------------------------------
# These are resolved by the browser, so they use localhost and the published
# host ports - not compose service names.
APP_SCIM_API_BASE_URL=http://localhost:8080
APP_VALIDATOR_URL=http://localhost:8082
