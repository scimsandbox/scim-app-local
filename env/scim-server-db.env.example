# Flyway migrations for the playground database (service: scim-server-db)
#
# Copy to scim-server-db.env before starting the stack.
# The host name is the compose service name, not localhost, because Flyway runs
# inside the compose network. Credentials must match env/postgres-server.env.

FLYWAY_URL=jdbc:postgresql://postgres-server:5432/scimserver
FLYWAY_USER=scim_server_app
FLYWAY_PASSWORD=local-dev-server-pw-change-me
