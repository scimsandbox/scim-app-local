# SCIM API, Go implementation (service: scim-server-impl-go)
# Used by docker-compose-go.yml. Serves the SCIM API on http://localhost:18080.
#
# Copy to scim-server-impl-go.env before starting the stack.
# Credentials must match env/postgres-server.env.
#
# Note the URL is a libpq-style DSN, not a JDBC URL. sslmode=disable is correct
# for the local compose network, where Postgres runs without TLS.

GO_DATASOURCE_URL=postgres://postgres-server:5432/scimserver?sslmode=disable
GO_DATASOURCE_USERNAME=scim_server_app
GO_DATASOURCE_PASSWORD=local-dev-server-pw-change-me

# Optional connection pool tuning - the image ships with defaults.
#GO_DATASOURCE_MAX_CONNS=50
#GO_DATASOURCE_MIN_CONNS=15

# Optional: debug, info, warn, error. Defaults to info.
#GO_LOGGING_LEVEL=debug
