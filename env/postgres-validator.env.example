# Validator PostgreSQL (service: postgres-validator, host port 5433)
#
# Copy to postgres-validator.env before starting the stack.
# These credentials are consumed by scim-validator-db and
# scim-validator-ui-spring - change them in all of those files together or the
# services will not be able to connect.
#
# Postgres only applies these when it initialises an empty data directory, so
# changing them after the first start has no effect until you drop the volume:
#   docker compose -f docker-compose-spring.yml down --volumes

POSTGRES_DB=scimvalidator
POSTGRES_USER=scim_validator_app
POSTGRES_PASSWORD=local-dev-validator-pw-change-me
